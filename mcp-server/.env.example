# Azure SQL connection string.
# Example (ActiveDirectoryInteractive – prompts for Entra ID login):
#   Driver={ODBC Driver 17 for SQL Server};Server=<server>.database.windows.net;Database=<db>;Authentication=ActiveDirectoryInteractive;Encrypt=yes
# Example (SQL login):
#   Driver={ODBC Driver 17 for SQL Server};Server=<server>.database.windows.net;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes
AZURE_SQL_CONN_STR=Driver={ODBC Driver 17 for SQL Server};Server=<your-server>.database.windows.net;Database=<your-db>;Uid=<your-username>;Pwd=<your-password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# MCP server bind address and port (defaults shown)
MCP_HOST=0.0.0.0
MCP_PORT=8000
